int main() {
    HMENU menu = CreatePopupMenu();
    HMENU submenu = CreatePopupMenu();
    assert(menu && submenu);
    AppendMenuW(submenu, MF_STRING, 30, L"Focus");
    AppendMenuW(menu, MF_STRING | MF_CHECKED, 2001, L"Lyrics");
    AppendMenuW(menu, MF_STRING | MF_GRAYED, 41, L"Empty");
    AppendMenuW(menu, MF_SEPARATOR, 0, nullptr);
    AppendMenuW(menu, MF_POPUP, reinterpret_cast<UINT_PTR>(submenu), L"Timer");
    GlassMenu context(nullptr, POINT{});
    context.Prepare(menu);
    MENUITEMINFOW item{sizeof(item)};
    item.fMask = MIIM_FTYPE | MIIM_STATE | MIIM_DATA | MIIM_ID | MIIM_SUBMENU;
    assert(GetMenuItemInfoW(menu, 0, TRUE, &item));
    assert((item.fType & MFT_OWNERDRAW) && (item.fState & MFS_CHECKED) && item.wID == 2001);
    auto* entry = reinterpret_cast<GlassMenuItem*>(item.dwItemData);
    assert(entry && entry->accessible.dwMSAASignature == MSAA_MENU_SIG);
    assert(wcscmp(entry->accessible.pszWText, L"Lyrics") == 0);
    assert(GetMenuItemInfoW(menu, 1, TRUE, &item) && (item.fState & MFS_DISABLED));
    assert(GetMenuItemInfoW(menu, 3, TRUE, &item) && item.hSubMenu == submenu);
    assert(GetMenuItemInfoW(submenu, 0, TRUE, &item) && item.wID == 30 && (item.fType & MFT_OWNERDRAW));
    MEASUREITEMSTRUCT measure{};
    measure.CtlType = ODT_MENU;
    measure.itemData = reinterpret_cast<ULONG_PTR>(entry);
    assert(context.Measure(&measure) && measure.itemHeight >= 28 && measure.itemWidth >= 180);
    HDC screen = GetDC(nullptr);
    HDC memory = CreateCompatibleDC(screen);
    HBITMAP bitmap = CreateCompatibleBitmap(screen, measure.itemWidth, measure.itemHeight);
    HGDIOBJ previous = SelectObject(memory, bitmap);
    DRAWITEMSTRUCT draw{};
    draw.CtlType = ODT_MENU;
    draw.itemData = measure.itemData;
    draw.hDC = memory;
    draw.rcItem = {0, 0, static_cast<LONG>(measure.itemWidth), static_cast<LONG>(measure.itemHeight)};
    assert(context.Draw(&draw));
    const auto normal = GetPixel(memory, 10, 10);
    draw.itemState = ODS_SELECTED;
    assert(context.Draw(&draw) && GetPixel(memory, 10, 10) != normal);
    SelectObject(memory, previous);
    DeleteObject(bitmap);
    DeleteDC(memory);
    ReleaseDC(nullptr, screen);
    DestroyMenu(menu);
}
